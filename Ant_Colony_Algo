import random

def fitness(x, y):
    return x**2 + y**2

N = 30
iterations = 50
rho = 0.5
Q = 100

grid = [
    (x, y)
    for x in range(-10, 11)
    for y in range(-10, 11)
]

pheromone = {point: 1.0 for point in grid}

for i in range(iterations):
    ants = []
    
    for j in range(N):
        weights = [
            pheromone[p] / (1 + fitness(p[0], p[1]))**2
            for p in grid
        ]
        
        point = random.choices(grid, weights=weights)[0]
        ants.append(point)
        
    for point in grid:
        pheromone[point] *= (1 - rho)
        
    for x, y in ants:
        cost = fitness(x, y)
        pheromone[(x, y)] += Q / (1 + cost)

best = min(grid, key=lambda p: fitness(p[0], p[1]))

print(f"Best X: {best[0]}")
print(f"Best Y: {best[1]}")
print(f"Minimum Value: {fitness(best[0], best[1])}")
